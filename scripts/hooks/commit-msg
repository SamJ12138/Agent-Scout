#!/bin/sh
# Refuses a commit message that contains personal data or a tool-attribution line.
# Install once with:  python scripts/install_hooks.py
cd "$(git rev-parse --show-toplevel)"
if [ -x .venv/bin/python ]; then
    python=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
    python=.venv/Scripts/python.exe
elif command -v python3 >/dev/null 2>&1; then
    python=python3
else
    python=python
fi
exec "$python" scripts/hygiene.py --commit-message "$1"
